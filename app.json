{
  "expo": {
    "name": "Imposter",
    "slug": "imposter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0717",
    "icon": "./assets/logo.png",
    "splash": {
      "backgroundColor": "#160E32",
      "resizeMode": "contain",
      "image": "./assets/logo.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gassane.imposter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#160E32"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
